{% extends 'languageConfig.twig' %}

{% set colors %}
<style>
:root {
    --logo_width: 445px;

    /* ========================= */
    /* 🎨 IDENTIDAD PRINCIPAL */
    /* ========================= */

    --main-color: #ff4747;          /* rojo Letal Network */
    --error-color: #ff7373;

    --hover-buy: #ff6b6b;
    --hover-sell: #b91f1f;
    --hover-info: #ffc048;          /* ámbar de la web */

    /* ========================= */
    /* 🖤 FONDOS OSCUROS PREMIUM */
    /* ========================= */

    --background-color: #160f0b;        /* fondo principal (igual que la web) */
    --second-background: #241a14;       /* tarjetas (cream-surface) */
    --third-background: #1d1510;        /* bloques internos (cream-soft) */
    --fourth-background: #2e2119;       /* navbar */

    --package-border: #3b2c22;          /* cream-border */

    /* ========================= */
    /* 📝 TEXTOS */
    /* ========================= */

    --primary-text-color: #f7eee4;      /* ink */
    --secondary-text-color: #b7a596;    /* ink-muted */
    --focus-text-color: #ff7373;

    /* ========================= */
    /* 🟡 ACENTO (CLAVE) */
    /* ========================= */

    --cold-color: #ffc048;              /* ámbar */

    /* ========================= */
    /* 🔘 BOTONES */
    /* ========================= */

    --green-button: #ff4747;
    --light-green: #4fd883;             /* verde de la web (categoría) */
    --disable-button: #4a1f1f;

    /* ========================= */
    /* ⚙️ GENERAL */
    /* ========================= */

    --font-family: Montserrat, sans-serif;

    --tiny-font: 12px;
    --small-font: 14px;
    --medium-font: 16px;
    --big-font: 18px;

    --border-radius: 16px;

    --header-img: url({{ config("background-image") }});
    --height-image: 530px;
    --opacity-image: 0.55;
    --blur-image: 0px;

    /* ========================= */
    /* 🎁 GIFTS */
    /* ========================= */

    --gift-color: #ffc048 !important;
    --gift-background: rgba(255,192,72,0.18) !important;
    --gift-accent-color: #ffd98a !important;
    --gift-text-color: #FFFFFF !important;
}
</style>
{% endset %}

